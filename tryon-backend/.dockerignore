# ==============================================================================
# TryFit Backend - Docker Ignore File
# Excludes unnecessary development files, secrets, and artifacts from build context
# ==============================================================================

# Node dependencies and logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Git version control
.git/
.gitignore

# Environment files and credentials (never bake secrets into images)
.env
.env.*
!.env.example
!.env.docker.example

# IDE, OS, and editor specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.DS_Store
Thumbs.db

# Test suites, coverage reports, and mocks
tests/
coverage/
.nyc_output/
TryFit_API_Postman_Collection.json
run_postman_with_seed.js
init_schema_check.txt

# Client / Flutter project artifacts (if present in parent context)
.dart_tool/
build/
android/
ios/
linux/
macos/
windows/
web/

# Logs and temporary files
*.log
*.tmp
*.temp

# Database dumps at root (keep src/db/init.sql for migrations)
/*.sql
tryfit_db.sql
tryfit_db_backup.sql
storage.rules
firestore.rules
