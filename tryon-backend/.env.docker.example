# ==============================================================================
# TryFit Backend - Docker Deployment Environment Configuration (.env.docker.example)
# ==============================================================================
# Copy this file to .env before running docker compose up:
#   cp .env.docker.example .env

# Server Configuration
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# MySQL Container Settings
# Note: In docker-compose, MYSQL_HOST should be set to 'mysql' (the service name).
# ------------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=strong_root_password_change_in_prod
MYSQL_DATABASE=tryfit_db
MYSQL_USER=tryon_app
MYSQL_PASSWORD=TryonApp@2026#Dev

# ------------------------------------------------------------------------------
# JWT Authentication Secret
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key

# ------------------------------------------------------------------------------
# MSG91 OTP Gateway (Optional for Phone/OTP Authentication)
# ------------------------------------------------------------------------------
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=699c5dfcdb9e18297e026415
MSG91_OTP_LENGTH=4

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Production Cloud Persistence)
# ------------------------------------------------------------------------------
# If left empty, backend runs with built-in Local In-Memory Fallback Adapter.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ------------------------------------------------------------------------------
# Virtual Try-On API (TryOnCloud)
# ------------------------------------------------------------------------------
TRYONCLOUD_API_KEY=your_tryoncloud_api_key
AI_PROVIDER_API_KEY=your_optional_ai_provider_key

# ------------------------------------------------------------------------------
# Payment Gateway Configuration
# ------------------------------------------------------------------------------
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret
