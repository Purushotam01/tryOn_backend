# ==============================================================================
# TryFit Backend - Docker Deployment Environment Configuration (.env.docker.example)
# ==============================================================================
# Copy this file to .env before running docker compose up:
#   cp .env.docker.example .env

# Server Configuration
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# MySQL Container Settings
# Note: In docker-compose, MYSQL_HOST should be set to 'mysql' (the service name).
# ------------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=strong_root_password_change_in_prod
MYSQL_DATABASE=tryfit_db
MYSQL_USER=tryon_app
MYSQL_PASSWORD=TryonApp@2026#Dev

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Production Cloud Persistence)
# ------------------------------------------------------------------------------
# If left empty, backend runs with built-in Local In-Memory Fallback Adapter.
FIREBASE_PROJECT_ID=tryon-8d7f7
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tryon-8d7f7.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=tryon-8d7f7.appspot.com

# ------------------------------------------------------------------------------
# Virtual Try-On API (TryOnCloud)
# ------------------------------------------------------------------------------
TRYONCLOUD_API_KEY=your_tryoncloud_api_key
AI_PROVIDER_API_KEY=your_optional_ai_provider_key

# ------------------------------------------------------------------------------
# Payment Gateway Configuration
# ------------------------------------------------------------------------------
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret
