{
  "info": {
    "_postman_id": "7b8f9a2e-4321-4f90-bc88-9d21124458ee",
    "name": "TryFit Cloud Backend API",
    "description": "Complete Postman testing suite for the TryFit centralized cloud backend service.\nIncludes endpoints for Profile, Wardrobe, Storage, Try-On Proxy, AI Match, Planner, Build My Week, Recent Picks, Coins, Subscriptions, and Notifications.",
