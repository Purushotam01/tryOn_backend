# ========================================================
# TryFit Backend Environment Configuration (.env.example)
# ========================================================

# Server Port & Environment
PORT=3000
NODE_ENV=development

# --------------------------------------------------------
# Firebase Admin SDK Configuration (Section 30)
# Obtain these from Firebase Console -> Project Settings -> Service Accounts
# --------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# --------------------------------------------------------
# Virtual Try-On API (TryOnCloud) (Section 11)
# Keep secure on backend. NEVER expose to client.
# --------------------------------------------------------
TRYONCLOUD_API_KEY=your_tryoncloud_api_key

# Optional Vision AI Provider (e.g. Gemini / OpenAI for enhanced match)
AI_PROVIDER_API_KEY=your_ai_provider_api_key

# --------------------------------------------------------
# Payment Gateway Configuration (Section 17)
# --------------------------------------------------------
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# --------------------------------------------------------
# Legacy / Optional OTP Configuration (MSG91 & MySQL)
# --------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=tryon_db
JWT_SECRET=your_jwt_secret_key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=699c5dfcdb9e18297e026415
MSG91_OTP_LENGTH=4
